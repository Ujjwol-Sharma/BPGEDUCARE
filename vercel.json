{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": {
      "bpg-live-db": false
    }
  },
  "functions": {
    "api/*.js": {
      "includeFiles": "data/**"
    }
  },
  "redirects": [
    { "source": "/admin", "destination": "/_not_found", "permanent": false },
    { "source": "/admin.html", "destination": "/_not_found", "permanent": false },
    { "source": "/data/(.*)", "destination": "/_not_found", "permanent": false },
    { "source": "/bpg-cms-data.json", "destination": "/_not_found", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/student-roster", "destination": "/api/academy-state?__route=student-roster" },
    { "source": "/api/send-email-otp", "destination": "/api/academy-state?__route=send-email-otp" },
    { "source": "/api/verify-otp", "destination": "/api/academy-state?__route=verify-otp" },
    { "source": "/api/content-access", "destination": "/api/academy-state?__route=content-access" },
    { "source": "/api/mock-tests", "destination": "/api/academy-state?__route=mock-tests" },
    { "source": "/api/payments", "destination": "/api/academy-state?__route=payments" },
    { "source": "/api/ai-tutor", "destination": "/api/academy-state?__route=ai-tutor" },
    { "source": "/admin", "destination": "/_not_found" },
    { "source": "/admin/(.*)", "destination": "/_not_found" },
    { "source": "/admin.html", "destination": "/_not_found" },
    { "source": "/data/(.*)", "destination": "/_not_found" },
    { "source": "/bpg-cms-data.json", "destination": "/_not_found" }
  ],
  "headers": [
    {
      "source": "/admin-k9x4m7p2q8z(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
